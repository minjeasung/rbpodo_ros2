<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rb_6dof_ros2_control" params="prefix robot_ip cb_simulation:=^|false use_fake_hardware:=^|false use_isaac_sim:=^|false fake_sensor_commands:=^|false torque_constants:=${[1, 1, 1, 1, 1, 1]}">
    <ros2_control name="RBPodoHardwareInterface" type="system">
      <hardware>
        <xacro:if value="${use_isaac_sim}">
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <param name="joint_commands_topic">/joint_command</param>
          <param name="joint_states_topic">/joint_states</param>
          <param name="sum_wrapped_joint_states">true</param>
        </xacro:if>
        <xacro:unless value="${use_isaac_sim}">
          <xacro:if value="${use_fake_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${use_fake_hardware}">
            <plugin>rbpodo_hardware/RBPodoHardwareInterface</plugin>
            <param name="cb_simulation">${cb_simulation}</param>
            <param name="robot_ip">${robot_ip}</param>
          </xacro:unless>
        </xacro:unless>
      </hardware>

      <xacro:macro name="configure_joint" params="joint_name torque_constant:=1 isaac:=false">
        <joint name="${joint_name}">
          <param name="initial_position">0.0</param>
          <param name="torque_constant">${torque_constant}</param>
          <xacro:if value="${isaac}">
            <!-- Isaac Sim: JointStateTopicSystem 은 position command 만 처리.
                 state_interface 도 공식 형식 (position+initial_value, velocity) 만; effort 없음. -->
            <command_interface name="position"/>
            <state_interface name="position">
              <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
          </xacro:if>
          <xacro:unless value="${isaac}">
            <command_interface name="effort"/>
            <command_interface name="velocity"/>
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
          </xacro:unless>
        </joint>
      </xacro:macro>

      <xacro:configure_joint joint_name="${prefix}base"     torque_constant="${torque_constants[0]}" isaac="${use_isaac_sim}" />
      <xacro:configure_joint joint_name="${prefix}shoulder" torque_constant="${torque_constants[1]}" isaac="${use_isaac_sim}" />
      <xacro:configure_joint joint_name="${prefix}elbow"    torque_constant="${torque_constants[2]}" isaac="${use_isaac_sim}" />
      <xacro:configure_joint joint_name="${prefix}wrist1"   torque_constant="${torque_constants[3]}" isaac="${use_isaac_sim}" />
      <xacro:configure_joint joint_name="${prefix}wrist2"   torque_constant="${torque_constants[4]}" isaac="${use_isaac_sim}" />
      <xacro:configure_joint joint_name="${prefix}wrist3"   torque_constant="${torque_constants[5]}" isaac="${use_isaac_sim}" />

    </ros2_control>
  </xacro:macro>
</robot>
